% set(gca,'units','normalize','position',[0 0 1 1],'color','none','TickLength',[0.0;0.0])
% 
% colorbar('position',[0.05 0.025 0.03 0.18],'fontsize',12,'fontweight','bold')
% c=quantile(abs(hp100plot1(~isnan(hp100plot1))),0.95);
% % if c<1;c=1;end
% caxis([-c c]);xlim([min(Lons(:)) max(Lons(:))]);ylim([min(Lats(:)) max(Lats(:))])
