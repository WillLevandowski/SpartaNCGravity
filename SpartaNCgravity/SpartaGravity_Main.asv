clear all 
close all
BougDens=2590;xbg=490000;ybg=4030000;

%%%% load the elevation interpolant
 tic; load ElevInterp4.mat;toc

 %%%% read data and reformat shorthand UTM coordinates from fieldwork
 dat=load('SpartaDay0real.txt');
 foo=find(dat(:,1)>7000);dat(foo,1)=dat(foo,1)-10000;
 foo=find(dat(:,2)<3500);dat(foo,2)=dat(foo,2)+10000;
 
 dat_=load('SpartaDay1.txt');
 foo=find(dat_(:,1)>7000);dat_(foo,1)=dat_(foo,1)-10000;
 foo=find(dat_(:,2)<3500);dat_(foo,2)=dat_(foo,2)+10000;
 dat=[dat;dat_];
 
 dat_=load('SpartaDay2.txt');
 foo=find(dat_(:,1)>7000);dat_(foo,1)=dat_(foo,1)-10000;
 foo=find(dat_(:,2)<3500);dat_(foo,2)=dat_(foo,2)+10000;
 dat=[dat;dat_];
 
 dat_=load('SpartaDay3.txt');
 foo=find(dat_(:,1)>7000);dat_(foo,1)=dat_(foo,1)-10000;
 foo=find(dat_(:,2)<3500);dat_(foo,2)=dat_(foo,2)+10000;
 dat=[dat;dat_];
 
 dat_=load('SpartaDay4.txt');
 foo=find(dat_(:,1)>7000);dat_(foo,1)=dat_(foo,1)-10000;
 foo=find(dat_(:,2)<3500);dat_(foo,2)=dat_(foo,2)+10000;
 dat=[dat;dat_];
 
 dat_=load('SpartaDay5.txt');
 foo=find(dat_(:,1)>7000);dat_(foo,1)=dat_(foo,1)-10000;
 foo=find(dat_(:,2)<3500);dat_(foo,2)=dat_(foo,2)+10000;
 dat=[dat;dat_];
 
 dat_=load('SpartaDay6.txt');
 foo=find(dat_(:,1)>5000);dat_(foo,1)=dat_(foo,1)-10000;
 foo=find(dat_(:,2)<3500);dat_(foo,2)=dat_(foo,2)+10000;
 dat=[dat;dat_];
 
 dat_=load('SpartaDay7.txt');
 foo=find(dat_(:,1)>5000);dat_(foo,1)=dat_(foo,1)-10000;
 foo=find(dat_(:,2)<3500);dat_(foo,2)=dat_(foo,2)+10000;
 dat=[dat;dat_];
 % okay=find(dat(:,1)>-3400);dat=dat(okay,:);

  x=dat(:,1);y=dat(:,2);g=dat(:,3);
  %%%%%% drift correction
g=driftModel(x,y,g,1297,8682);
 
%   plot(x,y,'ko')

 %%%%%% convert UTM to Lon,Lat

  Lon=0*x;Lat=0*y;
for i=1:numel(x)
    [a,b]=utm2deg(x(i)+xbg,y(i)+ybg,'17 S');
    Lon(i)=b;Lat(i)=a;
end
dlmwrite('GravityLocations2025.txt',[Lon Lat  ],'delimiter','\t','precision',8)

%%%%%% assign elevations to the gravity stations
E=ElevInterp(x+xbg,y+ybg);

%%%% Latitude correction
gn=978031.85*(1+0.005278895*sind(Lat).^2+0.000023462*sind(Lat).^4);LatCorr=gn-mean(gn);g=g-LatCorr;g=g-mean(g);
%%%% Free Air correction
FACorr=0.3086*E;FACorr=FACorr-min(FACorr);gFA=g+FACorr;gFA=gFA-mean(gFA);
%%%% Terrain correction
R=[  0:5:20 25:25:200 250:100:1050 1250:250:2000 3000:1000:10000];
TCkern=TerrainCorrections2(1,R,x+xbg,y+ybg,E,ElevInterp);
 toc
TC=TCkern*BougDens;
CFA=gFA+TC;CFA=CFA-mean(CFA);
%%%% First-pass Bouguer correction
BougCorr=-0.04193*BougDens/1000.*(E-min(E));CBA=CFA+BougCorr;CBA=CBA-mean(CBA);

%%%%%% Simultaneous inversion for regional trend surface and Bouguer
%%%%%% reduction density
res=Inv1101(x,y,E,CBA,'verbose');
% res=Inv1100(x,y,CBA); %%% or invert only for the regional trend surface

%%%%%% check repeatability of repeated readings
rep=x+NaN;nrep=x+NaN;
for i=1:length(x)
    match=find(x==x(i) & y==y(i));
    if length(match)>1
        rep(i)=res(i)-mean(res(match));
        nrep(i)=length(match);
    end
end

okay=find(~isnan(rep) & x~=1297);
xyr=[x(okay) y(okay) rep(okay)];
save xyrEg x y res E CBA
x0=x;y0=y;res0=res;E0=E;CBA0=CBA;save xyEr0 x0 y0 E0 res0 CBA0

%%%%% merge repeat readings 
x0=x;y0=y;res0=res;
xy=[x y];clear res
xy=unique(xy, 'rows');
x=xy(:,1);y=xy(:,2);res=0*x;E=0*x;CBA=0*x;FA=0*x;
rep=0*x+NaN;
nrep=0;rep_all=[];
for i=1:length(x)
    match=find(x0==x(i) & y0==y(i));
    res(i)=median(res0(match));
    CBA(i)=median(CBA0(match));
    FA(i)=median(gFA(match));
    E(i)=median(E0(match));
    if length(match)>1 && x(i)~=1297
        d=res0(match)-mean(res0(match));
        rep(i)=mean(abs(d));
        nrep=nrep+length(match);
        rep_all=[rep_all;d];
    end
end

%%%% add points around the periphery to steer interpolation
addpoints=[2060 10660 1.5
     3800 9350 1.1
    1125 8760 -0.3
    0958 8498 0.1
    0970 8419 0.1
    0800 8250 -0.1
    1600 8616 0.7
    1611 8720 0.85
    1661 8656 0.85
    1521 8656 0.7
    1381 8700 0.7
    ];
x=[x;addpoints(:,1)];
y=[y;addpoints(:,2)];
CBA=[CBA;addpoints(:,3)];

%%%% assign elevations; convert to Lon,Lat; re
E=ElevInterp(x+xbg,y+ybg);
 Lon=0*x;Lat=0*y;
for i=1:numel(x)
    [a,b]=utm2deg(x(i)+xbg,y(i)+ybg,'17 S');
    Lon(i)=b;Lat(i)=a;
end
res=Inv1101(x,y,E,CBA,'verbose');
% res=Inv1100(x,y,CBA);
 % make_contour(x,y,res,10,500);plot(x,y,'ko')

x0=x;y0=y;res0=res;E0=E;CBA0=CBA;save xyEr0 x0 y0 E0 res0 CBA0



rupture=[
 -81.11051025301117,36.49760044419381
 -81.10857334068579,36.49668118799458
 -81.10701009214218,36.49617467716713
  -81.1069197745563,36.4961334968436 %%% start of frank scarp
-81.10460471572951,36.49534397580601
 -81.10375784565663,36.49513805227845
 -81.10223512109368,36.49440182856058
 -81.10165887554777,36.49416863215851
 -81.09632613192191,36.49346442241623
 -81.09503515891736,36.4926869877766
 -81.09009016796071,36.49135865310393
 -81.08679386736564,36.48993845593977
 -81.08309681052788,36.48878249769825
 -81.08050146923327,36.48684766586492%% end of frank scarp
 -81.08050079805658,36.48685862392892
 -81.07681554698972,36.48433760967445
 -81.07558185166303,36.48395163738444
 -81.07297823012863,36.48213353141163
 -81.0707015545496,36.48038727232873
 ];

rup=[];
for i=1:length(rupture)-1
 foo=[linspace(rupture(i,1),rupture(i+1,1))' linspace(rupture(i,2),rupture(i+1,2))'];
 rup=[rup;foo];
end

[rupx,rupy]=deg2utm(rup(:,2),rup(:,1));
rupx=rupx-xbg;
rupy=rupy-ybg;

topoend=[-81.1306 36.5105];
topolin=[linspace(topoend(1),rupture(1,1))'  linspace(topoend(2),rupture(1,2))'];

topoend=[-81.0513 36.4665];
topolin2=[linspace(topoend(1),rupture(end,1))'  linspace(topoend(2),rupture(end,2))'];




%%
close all
tic
step=10;
[xx,yy]= gridxy(x,y,step);%(x(x>-1000 ),y(x>-1000 ),step);  

yy=flipud(yy);%yy(:,2:2:end)=yy(:,2:2:end)+step/2;
addpoints=[
            -5000 9000 NaN
            -5000 min(y) NaN
            3000 min(y)-1000 NaN
            min(x) min(y) NaN
            max(x) min(y) NaN
            min(x) max(y) NaN
            max(x) 11000 NaN
            max(x) 10000 NaN
            -2000 20000 NaN
            2000 20000 NaN
            ];

x0i=[x0;addpoints(:,1)];y0i=[y0;addpoints(:,2)];
xi=[x;addpoints(:,1)];yi=[y;addpoints(:,2)];
resi=[scatterGauss(x,y,res,5);addpoints(:,3)];
Frn=scatteredInterpolant(xi,yi,resi,'natural','none');
rrn=Frn(xx,yy);
Fr=scatteredInterpolant(x,y,scatterGauss(x,y,res,5),'natural','nearest');
rr=Fr(xx,yy);
x0=x;y0=y;res0=res;E0=E;
bougi=[scatterGauss(x,y,CBA,5);addpoints(:,3)];
Fbn=scatteredInterpolant(xi,yi,bougi,'natural','none');
bbn=Fbn(xx,yy);
Fb=scatteredInterpolant(x,y,scatterGauss(x,y,CBA,5),'natural','linear');
bb=Fb(xx,yy);
Fb0=scatteredInterpolant(x,y,scatterGauss(x,y,CBA,5),'natural','none');
bb0=Fb0(xx,yy);


h=res-scatterGauss(x,y,res,500);
hi=[scatterGauss(x,y,h,5);addpoints(:,3)];
Fhn=scatteredInterpolant(xi,yi,hi,'natural','none');
hhn=Fhn(xx,yy);
Fh=scatteredInterpolant(x,y,scatterGauss(x,y,h,5),'natural','nearest');
hh=Fh(xx,yy);

hh2=hh-gridGauss(hh,500,step);
hh2(isnan(rrn))=NaN;
% contour_plot(xx,yy,hh2);colorbar;colormap((stoplight_stretch4));



nearby=0*xx+NaN;
for i=1:length(x)
    d=sqrt( (x(i)-xx).^2+ (y(i)-yy).^2);
    nearby(d<1000)=0;
end
rrn=rrn+nearby;
bbn=bbn+nearby;

% for i=1:length(x)
%     d=sqrt( (x(i)-xx).^2+ (y(i)-yy).^2);
%     nearby(d<500)=1;
% end
% rrn(nearby==1 & isnan(rrn))=rr(nearby==1 & isnan(rrn));
% bbn(nearby==1 & isnan(bbn))=bb(nearby==1 & isnan(bbn));

Lons=0*xx;Lats=0*yy;
for i=1:numel(xx)
    [a,b]=utm2deg(xx(i)+xbg,yy(i)+ybg,'17 S');
    Lons(i)=b;Lats(i)=a;
end
