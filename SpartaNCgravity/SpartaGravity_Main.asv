% 
% % 
% % profile_x=linspace(978,1378,1000);
% % profile_y=linspace(8268 ,8825,1000);
% % 
% % F=scatteredInterpolant(x,y,res,'natural','nearest');
% % profile=F(profile_x,profile_y);
% % dx=profile_x-profile_x(1);dy=profile_y-profile_y(1);
% % dl=sqrt(dx.^2+dy.^2);
% % 
% % % p=polyfit(dl,profile,1);pred=polyval(p,dl);profile=profile-pred;
% % figure;plot(dl,profile,'k','linewidth',3);hold on
% % 
% % ylim([min(profile) max(profile)])
% % plot([528 528],[-999 999],'r')
% 
% 
% 
% profile_x=linspace(978,1474,1000);
