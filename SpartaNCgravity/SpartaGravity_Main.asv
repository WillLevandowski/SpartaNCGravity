% figure;s=surf(Lons,Lats,hp150plot1,hp150plot2,'FaceLighting','phong','FaceColor','interp', 'AmbientStrength',0.5,'SpecularStrength',0.5,'EdgeColor','k','EdgeAlpha',0.0);
