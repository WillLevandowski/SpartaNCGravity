% % figure;s=surf(Lons,Lats,hp150plot1,hp150plot2,'FaceLighting','phong','EdgeAlpha',0.0,'EdgeColor','none');
% colormap(flipud(hotcoldbreak));view(0,90)
% p=camlight('infinite');
% set(gcf,'Menu','none','Toolbar','none','position',[12 38 683 879]);
% set(gca,'units','normalize','position',[0 0 1 1],'color','none','TickLength',[0.0;0.0])
% caxis([-c c]);colormap(flipud(hotcoldbreak));
% xlim([min(Lons(:)) max(Lons(:))]);ylim([min(Lats(:)) max(Lats(:))])
% colorbar('Position',[0.1 0.025 0.025 0.2],'fontsize',12)
% 
%  saveas(gcf,'shadeHP750_2500_15m','jpg');
% [img1 cmap]=imread('shadeHP750_2500_15m.jpg');img=double(img1);
% lon=[min(Lons(:)) max(Lons(:)); min(Lons(:)) max(Lons(:))];lat=[max(Lats(:)) max(Lats(:)); min(Lats(:)) min(Lats(:))];
%  makekmz(img,lat,lon,'imname','shade_HP750_2500_15m');
% 
% 
% 
% 
% 
% 
% 
% %%
% 
% 
% 
% r=res;%-scatterGauss(x,y,res,1000);
% r=scatterGauss(x,y,r,25);
% makefig_makekmz(Lon,Lat,r,15/111e3,1000/111e3,'res_full','mGal',flipud(hotgraycold))
% r=r-scatterGauss(x,y,r,500);
% makefig_makekmz(Lon,Lat,r,15/111e3,500/111e3,'hp500','mGal',jet)
% 
% % 
% x0=x;y0=y;res0=res;
% xy=[x y];clear res
% xy=unique(xy, 'rows');
% x=xy(:,1);y=xy(:,2);res=0*x;
% for i=1:length(x)
%     match=find(x0==x(i) & y0==y(i));
%     res(i)=median(res0(match));
% end
% 
% 
% F=scatteredInterpolant(x,y,res,'natural','nearest');
% xx=-1500:100:3800;
% yy=6500:100:10500;
% [xx,yy]=mesh_replace(xx,yy);
% res=F(xx,yy);
% x=xx;y=yy;
% clear xx yy
% 
% E=ElevInterp(x+xbg,y+ybg);
% 
% min_spacing= sqrt((range(x)*range(y))/2000);
% zs_global=[750 500 275 150 100 50 25 0];
% gauss_sig=1000;smoothweight=1e-4;
% standardizedPartitionedInversion
% 
% %%
% 
% xxs=linspace(-1500,3500, 400);%   x(sta==2030),x(sta==2580)-5,200);
% yxs=linspace(9700,7850,length(xxs));% y(sta==2030)-20,y(sta==2580)-22,length(xxs));
% 
% dx=50;dy=100;
% cmin=-300;cmax=300;
% letter='A';
% figure(i_layer+1);
% standardizedCrossSection
% 
% % for i=1:i_layer;
% %     figure(i);hold on;plot(xxgp,yxgp,'k')
% % end
% 
% % % xy=[x(x~=1297) y(x~=1297)];
% % % xy=unique(xy,'rows');
% % % rep=xy(:,1)+NaN;
% % % for i=1:length(xy)
% % %     match=find(x==xy(i,1) & y==xy(i,2));
% % %     if length(match)>1
% % %         meanmatch=mean(res(match));
% % %         dmatch=res(match)-meanmatch;
% % %         rep(i)=mean(dmatch);
% % %     end
% % % end
% % %%
% % rep=NaN+x;
% % for i=1:length(x)
% %     match=find(x==x(i) & y==y(i));
% %     if length(match)>1
% %         meanmatch=mean(res(match));
% %         dmatch=res(match)-meanmatch;
% %         rep(i)=mean(abs(dmatch));
% %     end
% % end
% % rep(x==1297 & y==8682)=NaN;
% % % res=Inv1100(x,y,CBA);
% % % 
% % % p1=find(x==1317 & y==8665);
% % % p2=find(x==1697 & y==8803);
% % % 
% % % loc_x=x(p1)/2+x(p2)/2;
% % % loc_y=y(p1)/2+y(p2)/2;
% % % loc_Lon=Lon(p1)/2+Lon(p2)/2;
% % % loc_Lat=Lat(p1)/2+Lat(p2)/2;
% % % loc_res=res(p1)/2+res(p2)/2;
% % % 
% % % x=[x;loc_x];
% % % y=[y;loc_y];
% % % Lon=[Lon;loc_Lon];
% % % Lat=[Lat;loc_Lat];
% % % res=[res;loc_res];
% % % 
% % % loc_x=2*x(p1)/3+x(p2)/3;
% % % loc_y=2*y(p1)/3+y(p2)/3;
% % % loc_Lon=2*Lon(p1)/3+Lon(p2)/3;
% % % loc_Lat=2*Lat(p1)/3+Lat(p2)/3;
% % % loc_res=2*res(p1)/3+res(p2)/3;
% % % 
% % 
% % % x=[x;min(x);2650;2950;1050;1100;2100;max(x)-100;max(x)-100];
% % % y=[y;mean(y);9030;9070;10150;8500;10890;max(y);max(y)-100];
% % % res=[res;0;1;1;0.6;0.3;0.7;1;1];
% % 
% % 
% % % make_contour(x,y,res,20,500);plot(x,y,'g*');plot(x,y,'ko')
% % 
% % 
% % % Lon=0*x;Lat=0*y;
% % % for i=1:numel(dat(:,1))
% % %     [a,b]=utm2deg(x(i)+xbg,y(i)+ybg,'17 S');
% % %     Lon(i)=b;Lat(i)=a;
% % % end
% % 
% %  [Lat,Lon]=utm2deg(x+xbg,y+ybg,repmat('17 S',length(x),1));
% % 
% % 
% % % r=res;%-scatterGauss(x,y,res,1000);
% % % r=scatterGauss(x,y,r,25);
% % % makefig_makekmz(Lon,Lat,r,15/111e3,1000/111e3,'res_full','mGal',flipud(hotgraycold))
% % % r=r-scatterGauss(x,y,r,500);
% % % % r=scatterGauss(x,y,r,20);
% % % makefig_makekmz(Lon,Lat,r,15/111e3,500/111e3,'hp500','mGal',jet)
% % % % makefig_makekmz(Lon,Lat,res,5/111e3,325/111e3,'res250','mGal',(jet))
% % % % makefig_makekmz(Lon,Lat,CBA,5/111e3,555*2/111e3,'CBA','mGal',(jet))
% % % % makefig_makekmz(Lon,Lat,CBA,5/111e3,400/111e3,'CBA','mGal',(jet))
% % % 
% % % % make_contour(x,y,res,5,350);plot(x,y,'ko')
% 
% %%
% % close all
% step=10;
% [xx,yy]=gridxy(x,y,step);  yy=flipud(yy);
% % yy(2:2:end,:)=yy(2:2:end,:)+step/2;
% xi=[x;max(x)+500;min(x)-500;min(x)-500;max(x)+500;mean(x);mean(x)];
% yi=[y;max(y)+500;max(y)+500;min(y)-500;min(y)-500;max(y)+1000;min(y)-2000];
% % xi=[x;max(x);min(x);min(x);min(x)+1000;min(x)+2000;max(x);mean(x);mean(x);max(x)];
% % yi=[y;max(y);max(y);min(y);min(y);min(y);min(y);max(y);min(y);max(y);];
% Lons=0*xx;Lats=0*yy;
% for i=1:numel(xx);[a,b]=utm2deg(xx(i)+xbg,yy(i)+ybg,'17 S');Lons(i)=b;Lats(i)=a;end
% 
% tic
% near50=NaN+xx;
% for i=1:length(x)
%     d=sqrt( (yy-y(i)).^2+(xx-x(i)).^2);
%     near50(d<1000)=0;
% end
% toc
% 
% %% 
% hp=res;%scatterGauss(x,y,res,20);
% % hp=hp-scatterGauss(x,y,hp,500);
% resi=[hp;NaN(6,1)];
% % resi=[hp;NaN(9,1)];
% F=scatteredInterpolant(x,y,hp,'natural','nearest');
% Fn=scatteredInterpolant(xi,yi,resi,'natural','none');
% h=F(xx,yy);
% %  lp=gridGauss(h,1000,step);h=h-lp;
% h=gridGauss(h,20,step);
% hn=Fn(xx,yy);
% 
% 
% h(isnan(hn))=NaN;%h(isnan(h))=0; 
% h=h+near50;h(isnan(hn))=NaN;
% 
% 
% hp100plot1=h;hp100plot1=hp100plot1-median(hp100plot1(~isnan(hp100plot1)));hp100plot2=hp100plot1;
% % c=1.5;
% c=quantile(abs(hp100plot1(~isnan(hp100plot1))),1);
% hp100plot1(hp100plot1>c)=c;hp100plot1(hp100plot1<-c)=-c;
% hp100plot2(hp100plot2>c)=c;hp100plot2(hp100plot2<-c)=-c;hp100plot1(isnan(h))=NaN;hp100plot2(isnan(h))=NaN;
% 
% 
% 
% figure;s=surf(Lons,Lats,hp100plot1,hp100plot2,'FaceLighting','phong','FaceColor','interp', 'AmbientStrength',0.5,'SpecularStrength',0.5,'EdgeColor','k','EdgeAlpha',0.0);
