% caxis([-c c]);xlim([min(Lons(:)) max(Lons(:))]);ylim([min(Lats(:)) max(Lats(:))])
% 
% rupture=[-81.082134 36.488616
%    -81.107156 36.496116 ];
% hold on
% % plot3(rupture(:,1),rupture(:,2),0*rupture(:,1),'m','linewidth',4)
% % plot3(rupture(:,1),rupture(:,2),-0.25+0*rupture(:,1),'m','linewidth',4)
