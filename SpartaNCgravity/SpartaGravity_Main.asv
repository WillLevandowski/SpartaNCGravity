% img=double(img1);lon=[min(Lons(:)) max(Lons(:)); min(Lons(:)) max(Lons(:))];lat=[max(Lats(:)) max(Lats(:)); min(Lats(:)) min(Lats(:))];
% makekmz90(img,lat,lon,'imname','shadeHP500');
% 
% 
% % %%
% % p=load('bouguer.xyz');
% % okay=find(abs(p(:,1)--81.1)<0.35 & abs(p(:,2)-36.5)<0.3);
% % p=p(okay,:);
% % p(:,3)=p(:,3)-mean(p(:,3));
% % 
% % 
% % %% if Desktop/Decluster2023/SpartaSpecific/SpartaDesktop_v2 has been run recently
% % close all
% % F_desktop=scatteredInterpolant(Lon1,Lat1,g0,'natural','nearest');
% % g_desktop=F_desktop(Lon,Lat);
% % % res_desktop=Inv1100(x,y,g_desktop);
% % res_desktop=Inv1101(x,y,E,g_desktop,'verbose');
% % 
% % g_desktop=F_desktop(Lons,Lats);
% % make_contour(x,y,res_desktop,10,1000);
% % make_contour(x,y,res,10,1000);plot(x,y,'g*');plot(x,y,'ko')
% % 
% % 
% % dres=res-res_desktop;
% % make_contour(x,y,dres,10,1000);plot(x,y,'g*');plot(x,y,'ko')
% % 
% % makefig_makekmz(Lon,Lat,res_desktop,5/111e3,1000/111e3,'satelliteResgrav','mGal',flipud(hotcoldbreak))
% % 
% % 
% % res_desktop=F_desktop(Lons,Lats);
% % Lons_=Lons(~isnan(res_desktop));
% % Lats_=Lats(~isnan(res_desktop));
% % res_=res_desktop(~isnan(res_desktop));
% % res2=Inv1100(Lons_,Lats_,res_);
% % % make_contour(Lons_,Lats_,res2);
% % makefig_makekmz(Lons_,Lats_,res2,5/111e3,1000/111e3,'satelliteResgrav','mGal',flipud(hotcoldbreak))
% 
